
 
Question 1: Print Square Pattern 
Write a Java program to print a square pattern of stars (e.g., 4x4).
 
import java.util.Scanner;

public class Question1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of rows/columns: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}

 
Question 2: Print Perpendicular Line 
Write a Java program to print a T-shaped perpendicular star pattern
(e.g., 5 stars across the top and 4 stars down the center).
 
import java.util.Scanner;

public class Question2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of stars (odd number like 5): ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            if (i == 1) {
                for (int j = 1; j <= n; j++) {
                    System.out.print("* ");
                }
            } else {
                for (int s = 1; s <= n / 2; s++) {
                    System.out.print("  ");
                }
                System.out.print("*");
            }
            System.out.println();
        }
    }
}

 
